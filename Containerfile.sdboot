# dakota-lts:sdboot — AlmaLinux 6.12 LTS kernel on Dakota's systemd-boot stack
#
# Designed for `bootc switch` from a running Dakota install:
#
#   sudo bootc switch ghcr.io/hanthor/dakota-lts:sdboot
#
# Dakota's existing systemd-boot stays on the ESP unchanged. The AlmaLinux
# kernel drops in via the standard /usr/lib/modules/ path and BLS entries.
# No bootupd, no shim, no GRUB needed.
#
# Secure Boot is NOT enforced — Dakota ships no shim. For SB use :latest
# (GRUB chain) or :uki (shim 16.1 → AlmaLinux signed UKI).
#
# For composefs + systemd-boot, install fresh via fisherman:
#   {"bootloader":"systemd","composeFsBackend":true,"image":"...:sdboot"}
# fisherman handles the ext4 verity flag and root partition DDI GUID retagging
# that make composefs work with systemd-boot's GPT auto-discovery.
FROM quay.io/almalinuxorg/almalinux-bootc:10 AS alma

FROM ghcr.io/projectbluefin/dakota:latest

# Swap kernel: remove Dakota's source-built kernel, drop in AlmaLinux 6.12 LTS.
RUN find /usr/lib/modules -maxdepth 1 -mindepth 1 -type d -exec rm -rf {} +
COPY --from=alma /usr/lib/modules/ /usr/lib/modules/

# Stamp kernel version into os-release.
RUN KVER=$(ls /usr/lib/modules | head -1) \
 && sed -i "s|^KERNEL_VERSION=.*|KERNEL_VERSION=\"${KVER}\"|" /usr/lib/os-release 2>/dev/null \
 || echo "KERNEL_VERSION=\"${KVER}\"" >> /usr/lib/os-release

# Debug builds only: gate with --build-arg SSH_PUBKEY="$(cat ~/.ssh/id_ed25519.pub)"
ARG SSH_PUBKEY=""
RUN if [ -n "$SSH_PUBKEY" ]; then \
      systemctl enable sshd.service \
   && mkdir -p /var/roothome/.ssh \
   && echo "$SSH_PUBKEY" > /var/roothome/.ssh/authorized_keys \
   && chmod 700 /var/roothome/.ssh && chmod 600 /var/roothome/.ssh/authorized_keys \
   && printf 'PermitRootLogin prohibit-password\n' \
        > /etc/ssh/sshd_config.d/99-testing.conf; \
    fi
