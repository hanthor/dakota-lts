    "ghcr.io/hanthor/dakota-lts:latest",
    "ghcr.io/hanthor/dakota-lts:sdboot",
    "ghcr.io/hanthor/dakota-lts:uki",
    "ghcr.io/hanthor/dakota-lts:latest-nvidia",
    "ghcr.io/hanthor/dakota-lts:sdboot-nvidia",
    "ghcr.io/hanthor/dakota-lts:uki-nvidia"
  ]
}
